#!/bin/bash
# ./release — put the newest Takeoff installers behind the download page.
#   Page:     https://boreing-media.github.io/kite-download/
#   Windows:  ~/AppDevelopment/kite/out/Takeoff-Windows.zip
#   Mac:      newest ~/AppDevelopment/kite/out/Takeoff-*.dmg (published as Takeoff.dmg)
# Makes a new GitHub release marked "latest"; the page's links always point at latest.
# Each file also goes up under its old name (Kite-Windows.zip, Kite.dmg), the product's
# name until 6 Nov 2026, so links and one-liners people saved keep working.
set -euo pipefail
cd "$(dirname "$0")"
OUT=~/AppDevelopment/kite/out
WIN="$OUT/Takeoff-Windows.zip"
DMG=$(ls -t "$OUT"/Takeoff-*.dmg | head -1)
[ -f "$WIN" ] && [ -f "$DMG" ] || { echo "missing installer in $OUT" >&2; exit 1; }
mkdir -p out
cp "$WIN" out/Takeoff-Windows.zip
cp "$DMG" out/Takeoff.dmg
cp "$WIN" out/Kite-Windows.zip
cp "$DMG" out/Kite.dmg
TAG=$(date +%Y-%m-%d-%H%M)
GH() { ~/AppDevelopment/bin/gh-as samhaiman-boreingmedia "$@"; }
GH release create "$TAG" -R Boreing-Media/kite-download --latest \
  --title "Takeoff $TAG" --notes "Windows: $(basename "$WIN") ($(date -r "$WIN" '+%d %b %H:%M')). Mac: $(basename "$DMG")." \
  out/Takeoff-Windows.zip out/Takeoff.dmg out/Kite-Windows.zip out/Kite.dmg
# Install-Takeoff.cmd (the page's one-file install since 13 Nov 2026) needs no pin: it asks GitHub's API for the
# newest release and GitHub's own SHA-256 of the zip. win.txt (the old irm|iex one-liner, no longer on the page because
# Defender blocks that pattern as ClickFix) is still pinned for anyone who saved it.
# Pin this release in win.txt and on the page (13 Nov 2026): the one-liner downloads THIS tag and refuses
# a zip whose SHA-256 differs; the page shows the DMG's SHA-256. GitHub's own digest of each uploaded
# asset must equal the local file's, or nothing is pinned.
WSHA=$(shasum -a 256 out/Takeoff-Windows.zip | cut -d' ' -f1)
MSHA=$(shasum -a 256 out/Takeoff.dmg | cut -d' ' -f1)
for pair in "Takeoff-Windows.zip:$WSHA" "Takeoff.dmg:$MSHA"; do
  name=${pair%%:*}; want=${pair#*:}
  got=$(GH release view "$TAG" -R Boreing-Media/kite-download --json assets -q ".assets[]|select(.name==\"$name\")|.digest")
  [ "$got" = "sha256:$want" ] || { echo "uploaded $name digest ($got) differs from the local file ($want); win.txt NOT pinned" >&2; exit 1; }
done
sed -i '' -e "s/^\$tag  = '.*'/\$tag  = '$TAG'/" -e "s/^\$sha  = '.*'/\$sha  = '$WSHA'/" win.txt
sed -i '' -e "s#releases/download/[^/]*/Takeoff.dmg#releases/download/$TAG/Takeoff.dmg#" -e "s#<code id=\"macsha\">[0-9a-f]*</code>#<code id=\"macsha\">$MSHA</code>#" -e "s#<code id=\"winsha\">[0-9a-f]*</code>#<code id=\"winsha\">$WSHA</code>#" index.html
grep -q "^\$sha  = '$WSHA'" win.txt && grep -q "$MSHA" index.html && grep -q "$WSHA" index.html || { echo "pinning failed; check win.txt/index.html" >&2; exit 1; }
git add win.txt index.html && git commit -q -m "Pin Takeoff $TAG (SHA-256 checked)" && git pull -q --rebase && git push -q
echo "Live: https://boreing-media.github.io/kite-download/"
